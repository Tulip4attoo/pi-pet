{
  "name": "pi-pet-bubble",
  "version": "0.4.0",
  "description": "Desktop pet and status bubble for pi on native Windows or WSL.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:windows-smoke": "node --experimental-strip-types tests/windows-smoke.mjs"
  },
  "type": "module",
  "keywords": ["pi-package", "pi", "extension", "windows", "wsl", "overlay"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": ["./extensions/pet-bubble.ts"]
  }
}
